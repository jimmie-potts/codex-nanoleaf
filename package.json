{
  "name": "codex-nanoleaf",
  "version": "0.1.0",
  "private": true,
  "description": "Nanoleaf Lines task indicators and a local project wall map for Codex Desktop",
  "scripts": {
    "test:browser": "node scripts/test-browser.cjs",
    "verify": "node scripts/verify.mjs",
    "test:verify": "node --test --test-concurrency=1 tests/verify_checks.mjs",
    "test:verify:lifecycle": "node --test --test-concurrency=1 tests/verify_lifecycle.mjs",
    "openspec": "node scripts/openspec.cjs",
    "check:workflow": "node scripts/check-workflow.cjs",
    "test:workflow": "node --test tests/workflow_checks.cjs",
    "test:mcp": "npm --prefix mcp run verify && npm --prefix mcp test && npm --prefix mcp run typecheck",
    "test:prism": "node --test tests/prism_adapter_checks.cjs tests/prism_label_checks.cjs",
    "build:prism": "node scripts/export-prism.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.12.0",
    "@jimmie-potts/app-verify": "file:vendor/jimmie-potts-app-verify-1.1.0.tgz",
    "playwright": "1.63.0"
  }
}
